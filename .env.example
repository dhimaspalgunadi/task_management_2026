# PostgreSQL connection string (Netlify DB / Neon di produksi, Postgres lokal saat dev)
DATABASE_URL="postgresql://user:password@localhost:5432/it_task_mgmt?schema=public"

# String acak untuk NextAuth — generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak"

# URL produksi aplikasi (wajib diisi saat deploy, opsional saat dev lokal)
